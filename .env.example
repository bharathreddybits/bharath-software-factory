# ─────────────────────────────────────────────────────────────────────────────
# Bharath Software Factory — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# WARNING: service_role key bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Drizzle ORM) ────────────────────────────────────────────────────
# Direct Postgres connection string for Drizzle ORM and drizzle-kit migrations.
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler URL (port 6543) for serverless/edge deployments.
# Use the "Session" pooler URL (port 5432) for long-lived Node.js processes.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Authentication ────────────────────────────────────────────────────────────
# OAuth providers (configured in Supabase Dashboard → Auth → Providers)
# No extra env vars needed unless using custom OAuth apps.

# ── Payments — DoDo Payments (US) ────────────────────────────────────────────
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret

# ── Payments — Razorpay (India) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
# Sender shown to recipients, e.g. "MyApp <noreply@yourdomain.com>"
RESEND_FROM_ADDRESS=MyApp <noreply@yourdomain.com>

# ── Analytics — PostHog ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Error Monitoring — Sentry ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ── AI — Anthropic (Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── AI — OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Storage — Supabase Storage ────────────────────────────────────────────────
# Uses SUPABASE_SERVICE_ROLE_KEY above. No additional keys required.
# Set your bucket name:
NEXT_PUBLIC_STORAGE_BUCKET=public

# ── Rate Limiting — Upstash Redis (optional) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
